          "program_id"
        ],
        "title": "ApplicationCreate"
      },
      "ApplicationDocumentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "document_id": {
            "type": "integer",
            "title": "Document Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "id",
          "document_id",
          "name",
          "required",
          "description",
          "source_url",
          "status",
          "comment"
        ],
        "title": "ApplicationDocumentResponse"
      },
      "ApplicationDocumentUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(missing|ready|needs_review)$",
            "title": "Status"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000,
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ApplicationDocumentUpdate"
      },
      "ApplicationResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "program_id": {
            "type": "integer",
            "title": "Program Id"
          },
          "program_name": {
            "type": "string",
            "title": "Program Name"
          },
          "university": {
            "type": "string",
            "title": "University"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "completed_steps": {
            "type": "integer",
            "title": "Completed Steps"
          },
          "total_steps": {
            "type": "integer",
            "title": "Total Steps"
          },
          "next_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Step"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepResponse"
            },
            "type": "array",
            "title": "Steps"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/ApplicationDocumentResponse"
            },
            "type": "array",
            "title": "Documents",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "program_id",
          "program_name",
          "university",
          "status",
          "completed_steps",
          "total_steps",
          "next_step",
          "steps"
        ],
        "title": "ApplicationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProfileResponse": {
        "properties": {
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "age": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 16.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "current_education": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Education"
          },
          "graduation_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 2000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Graduation Year"
          },
          "degree": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degree"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "russian_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Russian Level"
          },
          "ui_language": {
