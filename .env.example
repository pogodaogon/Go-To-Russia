# Copy this file to .env for local development. Never commit real credentials.
APP_ENV=development
BOT_NAME=UniRoute Russia
DATABASE_URL=sqlite:///./admission_navigator.db

# MAX: leave empty for local mock mode.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_CA_BUNDLE=certs/max-ca-bundle.pem
MAX_WEBHOOK_SECRET=
WEBHOOK_PUBLIC_URL=

# Protect operator API endpoints in production.
API_KEY=

# Optional read-only credential for authorized reviewers; catalog GET routes only.
REVIEWER_API_KEY=

# Optional OpenAI-compatible language model.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

REMINDER_DAYS=30,7,1
ADMISSION_YEAR=2027
DEFAULT_CURRENCY=RUB

# Operator name selected by the project owner for the public privacy notice.
# Replace this if a legal entity is the data controller instead.
DATA_CONTROLLER_NAME=Тимошенко Никита Андреевич
# Set a monitored contact for privacy questions and deletion requests.
PRIVACY_CONTACT=natimoshenko28@gmail.com

# Docker Compose database settings; replace the password locally.
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=replace-with-a-local-random-password
